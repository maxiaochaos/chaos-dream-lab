# ==============================================================================
# CHAOS DREAM LAB · 梦境胶片放映厅 — 可选 AI 真实模型环境变量配置
# ==============================================================================
# 不配置以下 Key 时，系统自动运行在「完整内置暗房与影院渲染引擎」模式，
# 所有流程（录音、写梦、分镜解析、关键帧微调、动态放映、视频导出、票根生成）均可完整体验。
# 填入以下对应 Key 后，服务端 API 会自动切换至真实模型。

# 1. 梦境编剧与分镜解析 LLM（兼容 OpenAI Chat Completions 协议：OpenAI / DeepSeek / OpenRouter 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 2. 关键帧生图模型（如 gpt-image-1 / dall-e-3，默认复用 OPENAI_API_KEY 与 OPENAI_BASE_URL）
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-1

# 3. 语音转文字 ASR（默认复用 OPENAI_API_KEY，兼容 OpenAI Whisper 接口）
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1

# 4. 图生视频模型（如 Seedance / 豆包视频生成 / 自定义兼容端点）
SEEDANCE_API_KEY=
SEEDANCE_API_URL=
SEEDANCE_MODEL=seedance-1-0-pro
